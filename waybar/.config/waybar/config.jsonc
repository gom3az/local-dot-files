{
  "position": "top",
  "height": 43,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "hyprland/window": {
    "max-length": 50,
    "format": "{}"
  },
  "modules-center": [
  ],
  "modules-right": [
    "privacy",
    "custom/recording",
    "tray",
    "network",
    "custom/net-speed",
    "custom/bt",
    "pulseaudio",
    "pulseaudio#mic",
    "clock",
    "power-profiles-daemon",
    "custom/notification",
    "custom/power"
  ],
  "privacy": {
    "icon-spacing": 6,
    "icon-size": 14,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 18
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 18
      }
    ]
  },
  "tray": {
    "spacing": 8
  },
  "clock": {
    "format": "   {:%a %d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "network": {
    "format-wifi": "<span size='13000'>  </span>{essid}",
    "format-ethernet": "<span size='13000'>󰤭  </span> Disconnected",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "<span size='13000'>  </span>Disconnected",
    "format-disabled": "<span size='13000'>睊  </span>WiFi Off",
    "tooltip-format-wifi": "Signal Strenght: {signalStrength}%",
    "on-click": "$HOME/.local/bin/flex-wifi"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%  {desc}",
    "format-bluetooth": "{icon}  {volume}%",
    "format-muted": "  {desc}",
    "tooltip-format": "{desc}\nVolume: {volume}%\nRight-click to toggle mic mute",
    "format-icons": {
      "default": [
        "",
        "",
        " "
      ]
    },
    "max-length": 45,
    "on-click": "$HOME/.local/bin/flex-mixer",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  },
  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "tooltip-format": "Microphone: {source_desc} ({source_volume}%)\nClick to toggle mute",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    },
    "on-click": "$HOME/.local/bin/flex-profile"
  },
  "custom/net-speed": {
    "format": "{}",
    "exec": "$HOME/.local/bin/flex-net",
    "interval": 2,
    "return-type": "json",
    "tooltip": true,
    "on-click": "$HOME/.local/bin/flex net"
  },
  "custom/bt": {
    "format": "{}",
    "exec": "$HOME/.local/bin/flex-bt --status",
    "interval": 5,
    "return-type": "json",
    "tooltip": true,
    "on-click": "$HOME/.local/bin/flex bt"
  },
  "custom/recording": {
    "format": "{}",
    "exec": "~/.local/bin/flex-record status",
    "on-click": "~/.local/bin/flex-record stop",
    "interval": 2,
    "tooltip": false
  },
  "custom/notification": {
    "format": "{}",
    "exec": "$HOME/.local/bin/flex-notify",
    "interval": 2,
    "return-type": "json",
    "tooltip": true,
    "on-click": "$HOME/.local/bin/flex notify"
  },
  "custom/power": {
    "format": "",
    "on-click": "$HOME/.local/bin/flex-power",
    "tooltip": false
  }
}
